{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lista de indicadores ESG",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "cidade", "categoria", "valor", "unidade", "dataMedicao"],
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "cidade": { "type": "string", "minLength": 2 },
      "categoria": { "type": "string", "minLength": 2 },
      "valor": { "type": "number", "minimum": 0 },
      "unidade": { "type": "string", "minLength": 1 },
      "dataMedicao": { "type": "string", "format": "date-time" }
    },
    "additionalProperties": false
  }
}
